{
  "name": "@vv/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @vietvang/playwright-compiler --filter @vv/recorder --filter @playwright-studio/runner --filter @playwright-studio/reporter --filter @vv/ai --filter @playwright-studio/action-sdk build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@vv/recorder": "workspace:*",
    "@vietvang/playwright-compiler": "workspace:*",
    "@playwright-studio/runner": "workspace:*",
    "@vv/ai": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/websocket": "^11.0.0",
    "nanoid": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.0.0",
    "prisma": "^5.0.0"
  }
}
