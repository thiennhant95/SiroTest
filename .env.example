# Copy to .env and fill in. Single Windows host, NO Docker (see SELFHOST-WINDOWS.md).

# --- Database (SQLite file; absolute path recommended on Windows) ---
DATABASE_URL="file:./dev.db"

# --- Server ---
PORT=3001
# 32-byte base64 key for AES-256-GCM secret-variable encryption at rest
SERVER_SECRET_KEY="change-me-to-32-bytes-base64-key=="
# Alias accepted by self-host docs/scripts (same value, either name works)
SECRET_ENCRYPTION_KEY="change-me-to-32-bytes-base64-key=="
APP_SECRET="change-me-app-secret"

# --- Runner ---
# Max parallel Playwright runs on this host (P0 default 1-2; recorder never shares this pool)
MAX_CONCURRENT_RUNS=2
RUNNER_MAX_CONCURRENT=2
# Workspace browser for headed local recording (chromium only in P0)
# --- Storage / retention ---
# Artifact root: storage/runs/<run-id>/{result.json,trace.zip,video.webm,screenshots/}
STORAGE_PATH="./storage"
STORAGE_ROOT="./storage"
# Days to keep run artifacts (spec range 14-30; cleanup via `pnpm cleanup`)
ARTIFACT_RETENTION_DAYS=30

# --- Web (Vite) ---
VITE_API_BASE="http://localhost:3001/api/v1"

# --- Security toggles (11-security/security.md) ---
# Local E2E only — permits loopback/private run targets (fixture app).
# NEVER set to 1 on internet-facing deployments (SSRF risk).
# ALLOW_PRIVATE_TARGETS=1
