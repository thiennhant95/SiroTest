// P0: SQLite via Prisma; keep PostgreSQL-compatible (no db-specific types).
// provider sqlite locally; switch to postgresql without model changes.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  authRef   String   // password_hash or external auth ref
  role      String   @default("tester") // admin | developer | tester | viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tests     Test[]   @relation("CreatedTests")
  versions  TestVersion[]
  actions   Action[]
  members   ProjectMember[]
  auditLogs AuditLog[]
  tokens    AuthToken[]
}

// Stateful bearer tokens (real auth; x-user-id header stays dev-only).
// Only SHA-256 hashes are stored — raw tokens are shown once at login.
model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  name      String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  baseUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     ProjectMember[]
  envs        Environment[]
  variables   Variable[]
  tests       Test[]
  actions     Action[]
  files       FileAsset[]
  authProfiles AuthProfile[]
  baselines   Baseline[]
  healingProposals HealingProposal[]
  auditLogs   AuditLog[]
  suites      TestSuite[]
  schedules   Schedule[]
  runs        Run[]
  integrations Integration[]
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("editor") // owner | editor | viewer
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
}

model Environment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  isDefault Boolean  @default(false)
  baseUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variables Variable[]
  authProfiles AuthProfile[]
  runs      Run[]
  @@unique([projectId, name])
}

model Variable {
  id           String       @id @default(cuid())
  projectId    String
  environmentId String?
  key          String
  valueEncrypted String     // AES-256-GCM ciphertext (base64); never plaintext for secrets
  isSecret     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment  Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  @@unique([projectId, environmentId, key])
}

model Test {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  description    String?
    definitionJson String   // canonical TestDefinition JSON (steps stay embedded — P0 simplification)
    status         String   @default("draft") // draft | healthy | broken
    // Stability gate: set ONLY by POST /tests/:id/stability on N/N passes;
    // cleared on any definition edit (PATCH). A stamp means "this exact
    // definition passed N consecutive runs", not "passes forever".
    stable         Boolean  @default(false)
    stableAt       DateTime?
    stableRuns     Int      @default(0)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator        User     @relation("CreatedTests", fields: [createdBy], references: [id])
  versions       TestVersion[]
  runs           Run[]
  suites         SuiteTest[]
  baselines      Baseline[]
  healingProposals HealingProposal[]
}

model TestVersion {
  id            String   @id @default(cuid())
  testId        String
  versionNumber Int
  definitionJson String
  createdBy     String
  changeMessage String?
  createdAt     DateTime @default(now())
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  author        User     @relation(fields: [createdBy], references: [id])
  @@unique([testId, versionNumber])
}

// P1 — reusable business actions (project-scoped). Body holds
// { parameters, steps } per test-model reusableActionSchema (P0 steps only).
model Action {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  description    String?
  definitionJson String
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator        User     @relation(fields: [createdBy], references: [id])
  @@unique([projectId, name])
}

// P1 — suites (09-database/schema.md: test_suites + suite_tests).
model TestSuite {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  description String?
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tests       SuiteTest[]
  runs        Run[]
  schedules   Schedule[]
}

// P1 — auth profiles: stored login state (Playwright storageState JSON,
// encrypted at rest like secrets) reused across runs per environment.
model AuthProfile {
  id            String       @id @default(cuid())
  projectId     String
  environmentId String?
  name          String
  stateEncrypted String     // storageState JSON, AES-256-GCM (never plaintext after create)
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  @@unique([projectId, environmentId, name])
}

// P1 — file library for upload steps (stored under storage/files/, capped).
model FileAsset {
  id        String   @id @default(cuid())
  projectId String
  name      String   // original filename (sanitized)
  mimeType  String?
  sizeBytes Int
  path      String   // storage-relative path; never absolute server path to client
  createdBy String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// P1 — scheduled suite/test runs (in-process ticker; trigger 'schedule').
model Schedule {
  id            String     @id @default(cuid())
  projectId     String
  suiteId       String?
  testId        String?
  environmentId String
  cron          String     // minute hour dom month dow (5 fields)
  enabled       Boolean    @default(true)
  retries       Int        @default(0)
  browser       String     @default("chromium")
  headed        Boolean    @default(false)
  // Optional run inputs (null = default behavior, same as manual triggers).
  profileId     String?
  datasetId     String?
  rowIndex      Int?
  healWithAlternatives Boolean @default(false)
  // Failure alerting: opt-in chat notification + last terminal status.
  notifyOnFailure Boolean @default(false)
  lastStatus      String?
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite         TestSuite? @relation(fields: [suiteId], references: [id], onDelete: Cascade)
}

// P2 — visual regression baselines (screenshots under storage/baselines/).
model Baseline {
  id        String   @id @default(cuid())
  projectId String
  testId    String
  name      String   // baseline name (unique per test)
  path      String   // storage-relative path; never absolute server path to client
  width     Int?
  height    Int?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  @@unique([testId, name])
}

// P2 — explicit, reviewable locator healing proposals. A proposal is created
// when a stored alternative locator succeeds where the primary failed; it
// NEVER applies silently — a human approves (rewrites the step primary and
// demotes the old primary to alternatives) or rejects it.
model HealingProposal {
  id          String   @id @default(cuid())
  projectId   String
  testId      String
  stepId      String   // step id inside definition_json
  runId       String   // evidence run
  fromLocator String   // JSON of the failing primary candidate
  toLocator   String   // JSON of the succeeding alternative candidate
  evidence    String?  // JSON: { matchCount, preview, durationMs }
  status      String   @default("pending") // pending | approved | rejected
  createdBy   String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

// P2 — audit log (who did what, when). Written by mutating routes.
model AuditLog {
  id        String   @id @default(cuid())
  projectId String?
  userId    String?
  action    String   // e.g. test.create, run.cancel, healing.approve
  entityType String?
  entityId  String?
  details   String?  // JSON, redacted (never secrets)
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([projectId, createdAt])
}

// P2 — distributed worker registry (DB job-claim protocol, no extra infra).
// The in-process queue stays the default; remote workers register, send
// heartbeats and claim queued runs by worker id.
model Worker {
  id              String    @id @default(cuid())
  name            String    @unique
  status          String    @default("online") // online | draining | offline
  capacity        Int       @default(2)
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  runs            Run[]
}

model SuiteTest {
  suiteId   String
  testId    String
  sortOrder Int       @default(0)
  suite     TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  test      Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  @@id([suiteId, testId])
}

model Run {
  id           String    @id @default(cuid())
  projectId    String
  testId       String
  environmentId String?
  browser      String    @default("chromium")
  status       String    @default("queued") // queued|running|passed|failed|cancelled
  trigger      String    @default("manual")
  // P1 — suite linkage: suiteId = the suite, suiteRunId = one execution group.
  suiteId      String?
  suiteRunId   String?
  // P1 — data-driven: datasetId + rowIndex selected at trigger time.
  datasetId    String?
  rowIndex     Int?
  // P2 — distributed worker that claimed the run (null = local in-process).
  workerId     String?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  errorSummary String?
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  test         Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  environment  Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  suite        TestSuite? @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  worker       Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  steps        RunStep[]
  artifacts    Artifact[]
}

model RunStep {
  id            String  @id @default(cuid())
  runId         String
  stepId        String  // id inside definition_json
  sortOrder     Int
  status        String  @default("pending") // pending|running|passed|failed|skipped
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  errorMessage  String?
  screenshotPath String?
  run           Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Artifact {
  id        String   @id @default(cuid())
  runId     String
  type      String   // screenshot | trace | video | log | report
  path      String   // storage-relative path; never absolute server path to client
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// Outbound integrations (bug-from-failure): Jira / Backlog / Slack / Lark.
// configJson holds NON-secret fields (space, projectKey, webhookUrl…);
// secretJson holds encrypted credentials (apiToken, apiKey, signing secret)
// via security.ts encryptSecret — never returned to clients.
model Integration {
  id         String   @id @default(cuid())
  projectId  String
  provider   String   // jira | backlog | slack | lark
  name       String
  enabled    Boolean  @default(true)
  configJson String   @default("{}")
  secretJson String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider, name])
}
